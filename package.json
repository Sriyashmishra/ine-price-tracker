{
  "name": "ine-price-tracker-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack Product Price Tracker with resilient Playwright web scraping for INE",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
