    "build:client": "npm run build --prefix client",
    "scrape:headed": "npm run scrape:headed --prefix server",
    "scrape:test": "npm run scrape:test --prefix server"
  },
  "keywords": [
    "price-tracker",
    "playwright",
    "web-scraping",
    "react",
    "express",
    "supabase"
