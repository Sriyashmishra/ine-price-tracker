# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Secret token required to trigger the cron scraper (for cron-job.org)
CRON_SECRET=ine_secure_cron_secret_key_2026

# Supabase Credentials (from your Supabase project settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Scraper Settings
SCRAPER_HEADLESS=true
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT_MS=30000
MOCK_STORE_BASE_URL=https://demo.inelabteamdev.com
